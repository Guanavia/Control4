  <creator>David Woychek</creator>
  <manufacturer>Yamaha</manufacturer>
  <name>Yamaha Soundbar</name>
  <model>Yamaha Soundbar (umbrella)</model>
  <created>2026-07-25</created>
  <modified>2026-07-27</modified>
  <version>3</version>
  <small image_source="c4z">www/icons/device_sm.gif</small>
  <large image_source="c4z">www/icons/device_lg.gif</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <combo>false</combo>

  <proxies qty="1">
    <proxy proxybindingid="5001" name="Yamaha Soundbar" image_source="c4z"
           small_image="www/icons/device_sm.gif" large_image="www/icons/device_lg.gif">receiver</proxy>
  </proxies>

  <capabilities>
    <has_discrete_volume_control>True</has_discrete_volume_control>
    <has_up_down_volume_control>True</has_up_down_volume_control>
    <has_discrete_mute_control>True</has_discrete_mute_control>
    <has_toggle_mute_control>True</has_toggle_mute_control>
    <has_discrete_input_select>True</has_discrete_input_select>
    <allow_audio_pathing>True</allow_audio_pathing>
    <volume_number_of_steps>100</volume_number_of_steps>

    <!-- SURROUND.  These populate the Surround section of the device's control UI in Composer;
         without has_discrete_surround_mode_select + this list, that section is simply empty,
         which is why it was blank before.  Each id maps to a Yamaha "sound program" string in
         driver.lua's SURROUND_MODES - THE IDS MUST MATCH THAT TABLE.  All six were confirmed
         on hardware 2026-07-27 (written, read back, with a negative control). -->
    <has_discrete_surround_mode_select>True</has_discrete_surround_mode_select>
    <surround_modes>
      <surround_mode><name>Movie</name><id>1</id></surround_mode>
      <surround_mode><name>Music</name><id>2</id></surround_mode>
      <surround_mode><name>Sports</name><id>3</id></surround_mode>
      <surround_mode><name>Game</name><id>4</id></surround_mode>
      <surround_mode><name>TV Program</name><id>5</id></surround_mode>
      <surround_mode><name>Stereo</name><id>6</id></surround_mode>
    </surround_modes>

    <!-- EQ IS DELIBERATELY NOT DECLARED, and bass was TRIED AND WITHDRAWN (2026-07-28).
         The receiver proxy has no way to express a bass RANGE: there is no bass equivalent of
         volume_number_of_steps anywhere in its capability set.  With has_*_bass_control set,
         Composer renders an UNBOUNDED number box - Dave held the up arrow past 1000 - while the
         bar only accepts -4..+4, so the driver silently clamps and the number on screen becomes
         meaningless.  A control that lies about its own range is worse than no control, so bass
         now lives in the "Subwoofer Boost" property below, which IS bounded (RANGED_INTEGER
         -4..4) and renders honestly.  Treble/balance/loudness were never applicable: the bar has
         no such controls at all.  See README "Surround and EQ". -->
  </capabilities>

  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Yamaha Soundbar</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes><class><classname>RECEIVER</classname></class></classes>
    </connection>

    <!-- IP + online monitoring (UPnP control port) -->
    <connection>
      <id>6001</id>
      <type>4</type>
      <facing>6</facing>
      <connectionname>Network Connection</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>NETWORK</classname>
          <ports>
            <port>
              <number>49152</number>
              <auto_connect>True</auto_connect>
              <monitor_connection>True</monitor_connection>
              <keep_connection>False</keep_connection>
            </port>
          </ports>
        </class>
      </classes>
    </connection>

    <!-- Linkplay httpapi (:443, MUTUAL TLS) - power/input.  Driver-managed:
         the address comes from the "IP Address" property via C4:CreateNetworkConnection,
         so the dealer never enters the IP twice.  auto_connect/keep_connection are False
         because the Boa server on the bar is HTTP/1.0-ish and we send "Connection: close"
         (one connect per request).  certificate/private_key/cacert may all point at the
         SAME file (documented), and linkplay_client.pem holds leaf + issuing CA + key.
         verify_mode=none: the bar's SERVER cert is private-CA, we must not verify it.
         Key is a plain PEM PRIVATE KEY, so no protected attribute -> GetPrivateKeyPassword
         is never called.  FALLBACK if the plain key is rejected on hardware: rebuild with
         ENCRYPT_KEY=1, which re-encrypts the key AND stamps protected="True" on the
         private_key element below; driver.lua's GetPrivateKeyPassword already returns the
         matching passphrase, so no Lua edit is needed. -->
    <connection>
      <id>6002</id>
      <type>4</type>
      <facing>6</facing>
      <connectionname>Linkplay httpapi (SSL)</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>SSL</classname>
          <ports>
            <port>
              <name>httpapi</name>
              <number>443</number>
              <auto_connect>False</auto_connect>
              <monitor_connection>False</monitor_connection>
              <keep_connection>False</keep_connection>
              <certificate>./linkplay_client.pem</certificate>
              <private_key>./linkplay_client.pem</private_key>
              <cacert>./linkplay_client.pem</cacert>
              <verify_mode>none</verify_mode>
              <method>tlsv12</method>
            </port>
          </ports>
        </class>
      </classes>
    </connection>

    <!-- Room audio/video end-point -->
    <connection proxybindingid="5001">
      <id>7000</id>
      <type>7</type>
      <connectionname>AUDIO/VIDEO OUTPUT (to Room)</connectionname>
      <consumer>False</consumer>
      <audiosource>True</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class><classname>VIDEO_SELECTION</classname></class>
        <class><classname>AUDIO_SELECTION</classname></class>
        <class><classname>AUDIO_VOLUME</classname></class>
      </classes>
    </connection>

    <!-- HDMI Out (ARC) to TV -->
    <connection proxybindingid="5001">
      <id>2000</id>
      <type>5</type>
      <connectionname>HDMI OUT (to TV / ARC)</connectionname>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes><class><classname>HDMI</classname></class></classes>
    </connection>

    <!-- Input sources. <id> = InputBindingID carried by SET_INPUT; Lua INPUT_MAP -> switchmode value -->
    <connection proxybindingid="5001">
      <id>3000</id>
      <type>6</type>
      <connectionname>TV (ARC / Optical)</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource><videosource>False</videosource><linelevel>True</linelevel>
      <classes><class><classname>DIGITAL_OPTICAL</classname></class><class><classname>STEREO</classname></class></classes>
    </connection>
    <connection proxybindingid="5001">
      <id>3001</id>
      <type>6</type>
      <connectionname>HDMI In</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource><videosource>True</videosource><linelevel>True</linelevel>
      <classes><class><classname>HDMI</classname></class></classes>
    </connection>
    <!-- NOTE: there is deliberately NO separate "Optical In" input.  The YAS-209 has one
         optical/ARC input and the Linkplay layer exposes exactly one switchmode for it
         ("optical"), which is the same target the TV input uses.  A second connection
         would have been a duplicate control that selects the identical source. -->
    <connection proxybindingid="5001">
      <id>3003</id>
      <type>6</type>
      <connectionname>Bluetooth</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource><videosource>False</videosource><linelevel>True</linelevel>
      <classes><class><classname>STEREO</classname></class></classes>
    </connection>
    <connection proxybindingid="5001">
      <id>3004</id>
      <type>6</type>
      <connectionname>Network / Streaming</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource><videosource>False</videosource><linelevel>True</linelevel>
      <classes><class><classname>STEREO</classname></class></classes>
    </connection>
  </connections>

  <config>
    <power_management_method>DiscreteCodes</power_management_method>
    <power_command_delay>0</power_command_delay>
    <power_delay>0</power_delay>
    <power_command_needed>False</power_command_needed>
    <documentation file="www/documentation.rtf" />
    <script file="driver.lua" jit="1" />

    <properties>
      <property>
        <name>Driver Version</name>
        <type>STRING</type><readonly>true</readonly><default>2.1.0</default>
      </property>
      <property>
        <name>Model</name>
        <type>LIST</type><readonly>false</readonly><default>YAS-209</default>
        <items><item>YAS-209</item></items>
        <tooltip>Soundbar model. (Umbrella driver; more models added over time.)</tooltip>
      </property>
      <property>
        <name>Control Method</name>
        <type>LIST</type><readonly>false</readonly><default>IP</default>
        <items><item>IR</item><item>IP</item><item>Serial</item></items>
        <tooltip>How Control4 controls the bar. IP is implemented (UPnP + httpapi). IR/Serial are placeholders for later. NOTE: shipping default will be IR once IR is programmed.</tooltip>
      </property>
      <property>
        <name>IP Address</name>
        <type>STRING</type><readonly>false</readonly><default></default>
        <tooltip>Soundbar IP (use a DHCP reservation). Required for the IP control method.</tooltip>
      </property>
      <property>
        <name>Owner Approved</name>
        <type>LIST</type><readonly>false</readonly><default>No</default>
        <items><item>No</item><item>Yes</item></items>
        <tooltip>GRAY-AREA GATE. Power and input over IP use a client certificate extracted from Yamaha's app to reach the soundbar's local API. This is the EQUIPMENT OWNER's decision to enable. While "No", the driver still does volume/mute/transport (UPnP) and leaves power/input to IR. Set to "Yes" ONLY with the owner's consent.</tooltip>
      </property>
      <property>
        <name>Connected</name>
        <type>STRING</type><readonly>true</readonly><default>false</default>
      </property>
      <property>
        <name>Poll Interval Seconds</name>
        <type>RANGED_INTEGER</type><readonly>false</readonly><default>3</default><minimum>1</minimum><maximum>60</maximum>
        <tooltip>Volume/mute poll over UPnP. Cheap plaintext SOAP, so this can be fast.</tooltip>
      </property>
      <property>
        <name>State Poll Seconds</name>
        <type>RANGED_INTEGER</type><readonly>false</readonly><default>30</default><minimum>0</minimum><maximum>600</maximum>
        <tooltip>How often power and input are read BACK from the bar over httpapi, so the UI stays right when someone uses the Yamaha remote or front panel. Each read costs a full mutual-TLS handshake (one connect per request), so keep this well above the volume/mute poll. 0 disables state feedback and leaves power/input write-only. Requires Owner Approved = Yes.</tooltip>
      </property>
      <property>
        <name>Power State</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
      </property>
      <property>
        <name>Current Input</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
      </property>
      <property>
        <name>Current Volume</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
      </property>
      <property>
        <name>Muted</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
      </property>
      <!-- Yamaha sound settings.  Keys confirmed from a live YAMAHA_DATA_GET capture
           (2026-07-27); written back as YAMAHA_DATA_SET:{"<key>":"<value>"}.  All require
           Owner Approved = Yes, since they go over the httpapi path. -->
      <!-- Sound Program is NOT a property: it is the receiver proxy's surround mode, so it
           lives in the device's control UI (Surround section) via <surround_modes> above.
           The three toggles below have no equivalent in the receiver proxy - it models
           surround as one mode list, with no notion of independent DSP toggles - so a
           property is the only place they can live. -->
      <property>
        <name>3D Surround</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>On</item></items>
        <tooltip>DTS Virtual:X / 3D surround.</tooltip>
      </property>
      <property>
        <name>Clear Voice</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>On</item></items>
      </property>
      <property>
        <name>Bass Extension</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>On</item></items>
      </property>
      <property>
        <name>Subwoofer Boost</name>
        <type>RANGED_INTEGER</type><readonly>false</readonly><default>0</default><minimum>-4</minimum><maximum>4</maximum>
        <tooltip>Subwoofer level, matching the Yamaha app's Subwoofer Boost: -4 to +4, 0 = flat. Range learned from the bar itself (writes of 5 and -5 are refused) and independently confirmed against the app. This lives here rather than in the EQ section because the receiver proxy cannot express a bass range, so its EQ box is unbounded and would misrepresent this control.</tooltip>
      </property>
      <property>
        <name>Yamaha Volume</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
        <tooltip>The bar's own "Master volume" scale, which is NOT the same as the 0-100 UPnP volume Control4 drives. Shown for reference while the relationship between the two is worked out.</tooltip>
      </property>
      <property>
        <name>Audio Stream</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
        <tooltip>Incoming format the bar reports (PCM, Dolby, DTS ...).</tooltip>
      </property>

      <property>
        <name>Log Level</name>
        <type>LIST</type><readonly>false</readonly><default>2 - Warning</default>
        <items><item>0 - Alert</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Trace</item><item>5 - Debug</item></items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items>
      </property>
    </properties>

    <actions>
      <action><name>Refresh Now</name><command>RefreshNow</command></action>
      <action><name>Power On (IP)</name><command>PowerOn</command></action>
      <action><name>Power Off / Standby (IP)</name><command>PowerOff</command></action>
      <action><name>Play</name><command>TransportPlay</command></action>
      <action><name>Pause</name><command>TransportPause</command></action>
      <action><name>Stop</name><command>TransportStop</command></action>
      <action><name>Next Track</name><command>TransportNext</command></action>
      <action><name>Previous Track</name><command>TransportPrevious</command></action>
      <!-- getStatusEx is an IDENTITY/CAPABILITY dump only.  Proven on hardware 2026-07-27:
           five captures at five different inputs were identical except the clock (65 of 66
           fields), and it contains no mode/source/input/eq/surround key at all.  Use
           "Probe Yamaha Settings" for anything state-related. -->
      <action><name>Query Device Info (identity only — never shows input/state)</name><command>QueryDeviceInfo</command></action>
      <!-- Hardware-bringup diagnostics for the mutual-TLS path.  Set Log Level = 5 - Debug
           and Log Mode = Print and Log, then run these and read the log. -->
      <action><name>Test httpapi (SSL) - getStatusEx</name><command>TestHttpApi</command></action>
      <action><name>httpapi Diagnostics (cert + socket state)</name><command>HttpApiDiag</command></action>
      <!-- Capability discovery: dumps the raw read-command payloads so the surround/EQ
           key names and the input "mode" codes can be pinned down from a real session. -->
      <action><name>Probe Yamaha Settings (surround / EQ discovery)</name><command>ProbeSettings</command></action>
      <action><name>Learn Input Codes (cycles every input, then prints the table)</name><command>LearnInputCodes</command></action>
      <action><name>Learn Sound Programs (tries each candidate, reports which stick)</name><command>LearnSoundPrograms</command></action>
      <action><name>Learn Subwoofer Range (finds the boost limits, for a real bass slider)</name><command>LearnSubwooferRange</command></action>
    </actions>
  </config>

  <composer_categories>
    <category>Audio/Video</category>
    <category>Receiver</category>
  </composer_categories>

  <search_types>
    <type>yamaha:soundbar</type>
    <type>yamaha:yas-209</type>
  </search_types>
</devicedata>
