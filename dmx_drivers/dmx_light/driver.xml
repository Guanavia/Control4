  <config>
    <documentation file="www/documentation.html" />
    <script file="driver.lua" jit="1" />
    <properties>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>@BUILD@</default>
      </property>
      <property>
        <name>Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Fixture</name>
        <type>LABEL</type>
        <default>Fixture</default>
      </property>
      <property>
        <name>Fixture Type</name>
        <type>LIST</type>
        <items>
          <item>Single Color (On/Off)</item>
          <item>Single Color Dimmable</item>
          <item>Tunable White</item>
          <item>RGB</item>
          <item>RGBW</item>
          <item>RGBWW</item>
          <item>Extended Range / High Color Gamut</item>
          <item>Manual Color</item>
        </items>
        <default>RGBW</default>
        <tooltip>How the fixture maps onto Control4's lighting controls, the same way Control4's own DMX Light does. RGB and RGBW: color picker only (an RGBW's white is its white LED). Tunable White: temperature only. RGBWW (= RGBTW): color from RGB, temperature from the warm/cool white LEDs. Extended Range / High Color Gamut: the fixture mixes, from hue/saturation/intensity/temperature channels. Manual Color: brightness drives only the Dimmer channel; every color channel is set with Set Control. Changing type keeps the channel map if it still fits, otherwise starts from the type's usual map.</tooltip>
      </property>
      <property>
        <name>Gateway Line</name>
        <type>DYNAMIC_LIST</type>
        <default>1</default>
        <tooltip>Which DMX line (output) of the bound DMX gateway the fixture is wired to. Lists only the lines the gateway reports as DMX; with one, it is selected automatically. Until the gateway reports them, only the current setting is listed. Applies only when the DMX Gateway input is bound. Set it before the Start Address.</tooltip>
      </property>
      <property>
        <name>Start Address</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>512</maximum>
        <default>1</default>
        <tooltip>The fixture's DMX address, as set on its DIP switches or menu. For one zone of a pixel fixture split across several drivers, the address of the zone's first channel.</tooltip>
      </property>
      <property>
        <name>Footprint</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default></default>
        <tooltip>The DMX addresses this fixture occupies in the universe.</tooltip>
      </property>
      <property>
        <name>Layout Summary</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default></default>
        <tooltip>What is on each channel, numbered the way fixture manuals number them (Ch 1 = the Start Address). Read it against the manual's channel table to check the setup.</tooltip>
      </property>
      <property>
        <name>Channel Map</name>
        <type>STRING</type>
        <default></default>
        <tooltip>The whole layout as one line of text: copy it to set up an identical fixture, or paste a layout here. Examples: red,green,blue,white | dimmer,red,green,blue,white,strobe:8 (function:default) | 18x(red,green,blue,white) for 18 RGBW pixels | dimmer,strobe,8x(red,green,blue) for master channels followed by 8 RGB pixels.</tooltip>
      </property>
      <property>
        <name>Pixels</name>
        <type>LABEL</type>
        <default>Pixels</default>
      </property>
      <property>
        <name>Pixel Count</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>512</maximum>
        <default>1</default>
        <tooltip>1 for most fixtures (pars, washes, single-color tape): the whole fixture is one color. More than 1 for pixel bars, segmented fixtures and pixel tape, where the manual repeats the same group of channels for each pixel or segment. Every pixel shows the same color: the fixture is still ONE Control4 light.</tooltip>
      </property>
      <property>
        <name>Channels Per Pixel</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>12</maximum>
        <default>4</default>
        <tooltip>How many channels one pixel uses, e.g. 3 for RGB, 4 for RGBW, 5 for RGB + warm and cool white. Set what each one does below, in the manual's order.</tooltip>
      </property>
      <!-- @PIXEL_CHANNELS@ -->
      <property>
        <name>Fixture Channels</name>
        <type>LABEL</type>
        <default>Fixture Channels</default>
      </property>
      <property>
        <name>Channel Count</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>32</maximum>
        <default>4</default>
        <tooltip>Channels that act on the whole fixture. With Pixel Count 1 that is every channel the fixture uses (a par: dimmer, red, green, blue...). With pixels, only the channels outside the repeating pixel groups, such as a master dimmer, strobe or program channel; often 0.</tooltip>
      </property>
      <property>
        <name>Fixture Channels Before Pixels</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>32</maximum>
        <default>0</default>
        <tooltip>How many of the fixture channels come BEFORE the first pixel on the wire; the rest come after the last pixel. Most fixtures put them all first (set this to the Channel Count). 0 = the pixels start on Ch 1. Check the result in Layout Summary.</tooltip>
      </property>
      <!-- @CUSTOM_CHANNELS@ -->
      <property>
        <name>Output</name>
        <type>LABEL</type>
        <default>Output</default>
      </property>
      <property>
        <name>Default Fade (ms)</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>10000</maximum>
        <default>0</default>
        <tooltip>Fade used by the Set Control programming command.</tooltip>
      </property>
      <property>
        <name>Dimming Curve</name>
        <type>LIST</type>
        <items>
          <item>Auto</item>
          <item>1.0 (linear)</item>
          <item>1.8</item>
          <item>2.2</item>
          <item>2.6</item>
        </items>
        <default>Auto</default>
        <tooltip>Auto = 2.2 when the fixture has no dimmer channel (brightness scales the color channels), linear when it has one.</tooltip>
      </property>
      <property>
        <name>Tunable White Mode</name>
        <type>LIST</type>
        <items>
          <item>Standard Tunable White Fixture</item>
          <item>RGB White Mixing</item>
        </items>
        <default>Standard Tunable White Fixture</default>
        <tooltip>RGBWW only. Standard (as Control4): color temperature comes from the warm and cool white LEDs alone, colors from RGB alone. RGB White Mixing: the RGB LEDs add the same color temperature on top of the whites (brighter whites; the color is only as accurate as the RGB mix).</tooltip>
      </property>
      <property>
        <name>Color Space</name>
        <type>LIST</type>
        <items>
          <item>sRGB (Control4 standard)</item>
          <item>Rec. 2020 (wide gamut)</item>
          <item>Custom (fixture primaries)</item>
        </items>
        <default>sRGB (Control4 standard)</default>
        <tooltip>Extended Range only. The color space hue and saturation are measured in before they are sent to the fixture. sRGB matches Control4's own HSIC mode. Rec. 2020 or the fixture's own primaries let saturated colors use the fixture's wider gamut.</tooltip>
      </property>
      <property>
        <name>Custom Primaries</name>
        <type>STRING</type>
        <default>0.708,0.292,0.170,0.797,0.131,0.046</default>
        <tooltip>CIE 1931 x,y of the fixture's red, green and blue corners, from its spec sheet: rx,ry,gx,gy,bx,by. Used when Color Space is Custom.</tooltip>
      </property>
      <property>
        <name>Hue Offset (deg)</name>
        <type>RANGED_INTEGER</type>
        <minimum>-180</minimum>
        <maximum>180</maximum>
        <default>0</default>
        <tooltip>Extended Range only. Rotates the hue sent to the fixture, for fixtures whose hue 0 is not red. Pick red in the app and adjust until the fixture shows red.</tooltip>
      </property>
      <property>
        <name>CCT In Color Mode</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>255</default>
        <tooltip>Extended Range only. The value on the fixture's CCT channel while a color (not a white temperature) is selected. 255 as Control4's own HSIC mode; check the fixture manual.</tooltip>
      </property>
      <property>
        <name>White Mix (%)</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>100</maximum>
        <default>100</default>
        <tooltip>How much of the common R/G/B part is moved to the White emitter. 0 = never use White for colors.</tooltip>
      </property>
      <property>
        <name>CCT Min (K)</name>
        <type>RANGED_INTEGER</type>
        <minimum>1000</minimum>
        <maximum>10000</maximum>
        <default>2700</default>
      </property>
      <property>
        <name>CCT Max (K)</name>
        <type>RANGED_INTEGER</type>
        <minimum>1000</minimum>
        <maximum>10000</maximum>
        <default>6500</default>
      </property>
      <property>
        <name>Diagnostics</name>
        <type>LABEL</type>
        <default>Diagnostics</default>
      </property>
      <property>
        <name>Debug Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
    <actions>
      <action>
        <name>Identify</name>
        <command>IDENTIFY</command>
      </action>
      <action>
        <name>Re-register with Node</name>
        <command>REREGISTER</command>
      </action>
      <action>
        <name>Show Proxy Capabilities</name>
        <command>SHOW_PROXY_CAPS</command>
      </action>
    </actions>
    <commands>
      <command>
        <name>Set Control</name>
        <description>Set NAME PARAM1 to PARAM2</description>
        <params>
          <param>
            <name>Control</name>
            <type>DYNAMIC_LIST</type>
          </param>
          <param>
            <name>Value</name>
            <type>RANGED_INTEGER</type>
            <minimum>0</minimum>
            <maximum>255</maximum>
          </param>
        </params>
      </command>
      <command>
        <name>Restore Control Defaults</name>
        <description>Restore NAME controls to their defaults</description>
      </command>
      <command>
        <name>Identify</name>
        <description>Flash NAME three times</description>
      </command>
    </commands>
  </config>
</devicedata>
