  <creator>David Woychek</creator>
  <manufacturer>Art-Net</manufacturer>
  <name>Art-Net Node (LensShift)</name>
  <model>Art-Net Node (1 universe)</model>
  <created>2026-09-24</created>
  <modified>2026-09-24</modified>
  <version>17</version>
  <small image_source="c4z">www/icons/device_sm.png</small>
  <large image_source="c4z">www/icons/device_lg.png</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <!-- SELF-PROXY. A driver with no standard proxy must still name one, itself, or Composer says
       "driver added" and then never lists it (2026-10-08, bench). Same shape as Control4's
       ButtonTimer, LEDWizard and the Enttec master ExtraVeg_ArtNet_IP_Cloud. checks.py enforces. -->
  <proxy name="Art-Net Node">artnet_node</proxy>
  <minimum_os_version>3.3.2</minimum_os_version>
  <composer_categories>
    <!-- Others, not Lights: the node has no light proxy. Control4's own Enttec Art-Net master
         (self-proxy, no category) lands in "Other"; matching that proven shape exactly. -->
    <category>Others</category>
  </composer_categories>
  <connections>
    <!-- Fixtures bind here. Custom class ARTNET_DMX so only dmx_light / dmx_mover can connect.
         One output, many fixtures: whether Director lets ONE provider binding carry many
         consumers is Phase 0 item 4. If it does not, this becomes 24 numbered outputs. -->
    <connection>
      <id>1</id>
      <facing>6</facing>
      <connectionname>Fixtures</connectionname>
      <type>1</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>ARTNET_DMX</classname>
        </class>
      </classes>
    </connection>
  </connections>
  <config>
    <documentation file="www/documentation.html" />
    <script file="driver.lua" jit="1" />
    <properties>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>@BUILD@</default>
      </property>
      <property>
        <name>Status</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Starting</default>
      </property>
      <property>
        <name>Patch</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>No fixtures registered.</default>
      </property>
      <property>
        <name>Node</name>
        <type>LABEL</type>
        <default>Art-Net Node</default>
      </property>
      <property>
        <name>Node IP Address</name>
        <type>STRING</type>
        <default></default>
        <tooltip>The node's STATIC IP address on the Control4 LAN. Art-Net output is unicast to this address; a DHCP address that changes will silently stop the lights.</tooltip>
      </property>
      <property>
        <name>Art-Net Net</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>127</maximum>
        <default>0</default>
        <tooltip>Port-address Net, exactly as set on the node (0-127).</tooltip>
      </property>
      <property>
        <name>Art-Net Sub-Net</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>15</maximum>
        <default>0</default>
        <tooltip>Port-address Sub-Net, exactly as set on the node (0-15).</tooltip>
      </property>
      <property>
        <name>Art-Net Universe</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>15</maximum>
        <default>0</default>
        <tooltip>Port-address Universe, exactly as set on the node (0-15). Same numbering as the node: no "universe 0 vs 1" translation.</tooltip>
      </property>
      <property>
        <name>Timing</name>
        <type>LABEL</type>
        <default>Timing</default>
      </property>
      <property>
        <name>Keepalive (ms)</name>
        <type>RANGED_INTEGER</type>
        <minimum>500</minimum>
        <maximum>4000</maximum>
        <default>1000</default>
        <tooltip>How often the frame is re-sent when nothing changes. Art-Net nodes expect a refresh roughly every second.</tooltip>
      </property>
      <property>
        <name>Max Frame Rate (fps)</name>
        <type>RANGED_INTEGER</type>
        <minimum>10</minimum>
        <maximum>44</maximum>
        <default>30</default>
        <tooltip>Cap on frames per second while fades are running.</tooltip>
      </property>
      <!-- CHANNEL TEST. Live properties rather than an Action: an Action dialog is a fixed form
           (cannot add a slider per channel as the count changes) and only applies on OK, while a
           SCROLL property is a slider that takes effect as it moves (RANGED_INTEGER is only a
           numeric box in Composer; SCROLL is documented since OS 2.10, no shipping sample seen). The driver shows only
           as many Test Ch sliders as Test Channels asks for, and forces Test Channels back to Off
           on every load so a forgotten test can never override the fixtures after a reboot. -->
      <property>
        <name>Channel Test</name>
        <type>LABEL</type>
        <default>Channel Test</default>
      </property>
      <property>
        <name>Test Channels</name>
        <type>LIST</type>
        <items>
            <item>Off</item>
            <item>1</item>
            <item>2</item>
            <item>3</item>
            <item>4</item>
            <item>5</item>
            <item>6</item>
            <item>7</item>
            <item>8</item>
            <item>9</item>
            <item>10</item>
            <item>11</item>
            <item>12</item>
            <item>13</item>
            <item>14</item>
            <item>15</item>
            <item>16</item>
        </items>
        <default>Off</default>
        <tooltip>How many consecutive DMX channels to drive by hand, starting at Test Start Channel. While not Off, these channels hold the slider values and override every fixture. Returns to Off when the driver reloads.</tooltip>
      </property>
      <property>
        <name>Test Start Channel</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>512</maximum>
        <default>1</default>
        <tooltip>DMX address driven by Test Ch 1. Test Ch 2 is the next address, and so on.</tooltip>
      </property>
      <property>
        <name>Test Addresses</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>Test off</default>
      </property>
      <property>
        <name>Test Ch 1</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 2</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 3</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 4</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 5</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 6</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 7</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 8</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 9</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 10</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
