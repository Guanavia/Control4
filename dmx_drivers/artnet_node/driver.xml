        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Test Ch 13</name>
        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
