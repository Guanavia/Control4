        <type>SCROLL</type>
        <minimum>0</minimum>
        <maximum>255</maximum>
        <default>0</default>
      </property>
      <property>
        <name>Diagnostics</name>
        <type>LABEL</type>
        <default>Diagnostics</default>
      </property>
      <property>
        <name>Debug Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
      </property>
    </properties>
    <actions>
      <action>
        <name>Resend Frame</name>
        <command>RESEND</command>
      </action>
      <action>
        <name>Blackout Universe</name>
        <command>BLACKOUT</command>
      </action>
      <action>
        <name>Re-sync Fixtures</name>
        <command>RESYNC</command>
      </action>
    </actions>
  </config>
</devicedata>
