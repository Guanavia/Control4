  <capabilities>
    <!-- IR ONLY, and the capability list is written to match that honestly.
         has_discrete_volume_control is NOT declared: the remote has only up/down keys, there is
         no network on this model, and so nothing could ever correct an estimated absolute level.
         Declaring it would make Navigator send SET_VOLUME_LEVEL and force the driver to guess
         forever. Up/down is what the hardware actually offers.
         has_discrete_mute_control is NOT declared for the same reason - the remote has a mute
         TOGGLE only, and the captured discrete codes came back empty. -->
    <has_up_down_volume_control>True</has_up_down_volume_control>
    <has_toggle_mute_control>True</has_toggle_mute_control>
    <has_discrete_input_select>True</has_discrete_input_select>
    <allow_audio_pathing>True</allow_audio_pathing>

    <!-- The YAS-108's two real listening modes. DTS Virtual:X is a separate toggle on the
         remote, not a mode, so it is a property rather than an entry here. -->
    <has_discrete_surround_mode_select>True</has_discrete_surround_mode_select>
    <surround_modes>
      <surround_mode><name>Surround</name><id>1</id></surround_mode>
      <surround_mode><name>Stereo</name><id>2</id></surround_mode>
    </surround_modes>
  </capabilities>

