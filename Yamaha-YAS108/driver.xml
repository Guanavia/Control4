    <documentation file="www/documentation.rtf" />
    <script file="driver.lua" jit="1" />

    <properties>
      <property>
        <name>Driver Version</name>
        <type>STRING</type><readonly>true</readonly><default>@BUILD@</default>
      </property>

      <!-- ASSUMED state. Deliberately named "Assumed" rather than "Current": the YAS-108 has no
           network interface, so the driver cannot read anything back and every value here is
           what it last COMMANDED. Naming them "Current" would put the lie in the label. -->
      <property>
        <name>Assumed Power</name>
        <type>STRING</type><readonly>true</readonly><default>Standby</default>
        <tooltip>What the driver believes. Not read from the bar - this model has no feedback path. Use the Resync actions if it has drifted.</tooltip>
      </property>
      <property>
        <name>Assumed Input</name>
        <type>STRING</type><readonly>true</readonly><default>unknown</default>
      </property>
      <property>
        <name>Assumed Volume</name>
        <type>STRING</type><readonly>true</readonly><default>20</default>
        <tooltip>Estimated percentage. IR volume is relative, so this drifts if the bar is changed by its own remote.</tooltip>
      </property>
      <property>
        <name>Assumed Mute</name>
        <type>STRING</type><readonly>true</readonly><default>false</default>
      </property>

      <!-- Sound settings. All three are TOGGLE-only on the remote, so the driver flips them and
           says so; with no network on this model there is no readback to correct against. -->
      <property>
        <name>DTS Virtual:X (3D Surround)</name>
        <type>LIST</type><items><item>Off</item><item>On</item></items>
        <default>Off</default><readonly>false</readonly>
        <tooltip>Virtual surround. The remote has a toggle only, so the driver flips this rather than setting it to an exact state.</tooltip>
      </property>
      <property>
        <name>Clear Voice</name>
        <type>LIST</type><items><item>Off</item><item>On</item></items>
        <default>Off</default><readonly>false</readonly>
        <tooltip>Dialogue enhancement. Toggle only - see DTS Virtual:X.</tooltip>
      </property>
      <property>
        <name>Bass Extension</name>
        <type>LIST</type><items><item>Off</item><item>On</item></items>
        <default>Off</default><readonly>false</readonly>
        <tooltip>Bass enhancement. Toggle only - see DTS Virtual:X.</tooltip>
      </property>
      <property>
        <name>Bluetooth Standby</name>
        <type>LIST</type><items><item>Off</item><item>On</item></items>
        <default>Off</default><readonly>false</readonly>
        <tooltip>Lets a paired device wake the soundbar over Bluetooth. Toggle only.</tooltip>
      </property>

      <property>
        <name>Subwoofer Level</name>
        <type>RANGED_INTEGER</type><minimum>-4</minimum><maximum>4</maximum>
        <default>0</default><readonly>false</readonly>
        <tooltip>Built-in subwoofer level, -4 to +4 with 0 flat. Sent as up/down steps from the last value the driver set. IR gives no confirmation, so this can drift if the remote is also used.</tooltip>
      </property>

      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <items><item>0 - Alert</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Trace</item><item>5 - Debug</item></items>
        <default>2 - Warning</default><readonly>false</readonly>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items>
        <default>Off</default><readonly>false</readonly>
      </property>
    </properties>

    <actions>
      <!-- IR install check. Fires ONE code with nothing else in the path and reports what
           Director says is bound to the IR output. IR is one-way, so without this a wrong code
           and a dead emitter or unbound port are indistinguishable. -->
      <action><name>Test IR Emitter (fires Power Toggle)</name><command>TestIrEmitter</command></action>
      <action><name>Show Assumed State</name><command>ShowAssumedState</command></action>
      <!-- Power is TOGGLE-ONLY on this remote, so the driver synthesises discrete on/off from an
           assumed state. If someone uses the bar's own remote that assumption inverts and every
           later power command is backwards. These correct it WITHOUT sending IR. -->
      <action><name>Resync: bar is actually ON</name><command>ResyncPowerOn</command></action>
      <action><name>Resync: bar is actually OFF</name><command>ResyncPowerOff</command></action>
      <action><name>IR: Dimmer</name><command>IrFire_DIMMER</command></action>
      <action><name>IR: Info</name><command>IrFire_INFO</command></action>
    </actions>
  </config>

