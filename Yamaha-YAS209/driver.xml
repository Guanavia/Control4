    <documentation file="www/documentation.rtf" />
    <script file="driver.lua" jit="1" />

    <properties>
      <!-- The default below is a build token, replaced at package time with the real packaged
           <version> plus a content fingerprint. It used to be a hand-maintained "2.1.0" that
           drifted out of step with the <version> Composer actually compares on update, so this
           property displayed one number while the driver was another. Never hardcode a version
           here again: this property, the load-line log and <version> all come from one stamp. -->
      <property>
        <name>Driver Version</name>
        <type>STRING</type><readonly>true</readonly><default>@BUILD@</default>
      </property>
      <!-- IR is the DEFAULT and the standard method for this driver: it needs no certificate,
           no network and no documentation to use. IP is the owner's path and is signposted in
           its own label because it cannot be made self-explanatory in a dropdown.
           SERIAL WAS REMOVED: the YAS-209 has no serial port and never will, so offering it was
           an invitation to mis-configure. Labels are free text - driver.lua matches the leading
           "IP"/"IR" only, so this wording can change without a code edit. -->
      <property>
        <name>Control Method</name>
        <type>LIST</type>
        <items>
          <item>IR</item>
          <item>IP - See Documentation for Usage</item>
        </items>
        <default>IR</default>
        <readonly>false</readonly>
        <tooltip>IR is standard and works out of the box. IP adds state feedback and discrete control but requires setup - read the driver documentation before selecting it.</tooltip>
      </property>
      <property>
        <name>IP Address</name>
        <type>STRING</type><readonly>false</readonly><default></default>
        <tooltip>Soundbar IP (use a DHCP reservation). Required for the IP control method.</tooltip>
      </property>
      <property>
        <name>Connected</name>
        <type>STRING</type><readonly>true</readonly><default>IP Control Only - see documentation</default>
      </property>
      <property>
        <name>Poll Interval Seconds</name>
        <type>RANGED_INTEGER</type><readonly>false</readonly><default>3</default><minimum>1</minimum><maximum>60</maximum>
        <tooltip>Volume/mute poll over UPnP. Cheap plaintext SOAP, so this can be fast.</tooltip>
      </property>
      <property>
        <name>State Poll Seconds</name>
        <type>RANGED_INTEGER</type><readonly>false</readonly><default>30</default><minimum>0</minimum><maximum>600</maximum>
        <tooltip>How often power and input are read BACK from the bar over httpapi, so the UI stays right when someone uses the Yamaha remote or front panel. Each read costs a full mutual-TLS handshake (one connect per request), so keep this well above the volume/mute poll. 0 disables state feedback and leaves power/input write-only. Requires Control Method = IP.</tooltip>
      </property>
      <property>
        <name>Power State</name>
        <type>STRING</type><readonly>true</readonly><default>IP Control Only - see documentation</default>
      </property>
      <property>
        <name>Current Input</name>
        <type>STRING</type><readonly>true</readonly><default>IP Control Only - see documentation</default>
      </property>
      <property>
        <name>Current Volume</name>
        <type>STRING</type><readonly>true</readonly><default>IP Control Only - see documentation</default>
      </property>
      <property>
        <name>Muted</name>
        <type>STRING</type><readonly>true</readonly><default>IP Control Only - see documentation</default>
      </property>
      <!-- Yamaha sound settings.  Keys confirmed from a live YAMAHA_DATA_GET capture
           (2026-07-27); written back as YAMAHA_DATA_SET:{"<key>":"<value>"}.  All require
           Control Method = IP, since they go over the httpapi path. -->
      <!-- Sound Program is NOT a property: it is the receiver proxy's surround mode, so it
           lives in the device's control UI (Surround section) via <surround_modes> above.
           The three toggles below have no equivalent in the receiver proxy - it models
           surround as one mode list, with no notion of independent DSP toggles - so a
           property is the only place they can live. -->
      <property>
        <name>3D Surround</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>On</item></items>
        <tooltip>DTS Virtual:X / 3D surround.</tooltip>
      </property>
      <property>
        <name>Clear Voice</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>On</item></items>
      </property>
      <!-- HDMI-CEC on the soundbar. Not exposed in the Yamaha app, so this is the only way to
           reach it. Added to test whether the bar's CEC is interfering with TV input selection.
           Reading it is confirmed; writing it has never been tried. -->
      <property>
        <name>HDMI Control (CEC)</name>
        <type>LIST</type><items><item>Off</item><item>On</item></items>
        <default>On</default><readonly>false</readonly>
        <tooltip>HDMI-CEC on the soundbar. Turning this off stops the bar taking part in CEC, which is worth trying if it is competing with Control4 over the TV's input. Requires Control Method = IP. Writing this setting is unverified - check it held with Get Device Status.</tooltip>
      </property>
      <property>
        <name>Bass Extension</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>On</item></items>
      </property>
      <property>
        <name>Subwoofer Boost</name>
        <type>RANGED_INTEGER</type><readonly>false</readonly><default>0</default><minimum>-4</minimum><maximum>4</maximum>
        <tooltip>Subwoofer level, matching the Yamaha app's Subwoofer Boost: -4 to +4, 0 = flat. Range learned from the bar itself (writes of 5 and -5 are refused) and independently confirmed against the app. This lives here rather than in the EQ section because the receiver proxy cannot express a bass range, so its EQ box is unbounded and would misrepresent this control.</tooltip>
      </property>

      <property>
        <name>Log Level</name>
        <type>LIST</type><readonly>false</readonly><default>2 - Warning</default>
        <items><item>0 - Alert</item><item>1 - Error</item><item>2 - Warning</item><item>3 - Info</item><item>4 - Trace</item><item>5 - Debug</item></items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type><readonly>false</readonly><default>Off</default>
        <items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items>
      </property>
    </properties>

    <actions>
      <!-- getStatusEx is an IDENTITY/CAPABILITY dump only.  Proven on hardware 2026-07-27:
           five captures at five different inputs were identical except the clock (65 of 66
           fields), and it contains no mode/source/input/eq/surround key at all.  Use
           "Probe Yamaha Settings" for anything state-related. -->
      <!-- Hardware-bringup diagnostics for the mutual-TLS path.  Set Log Level = 5 - Debug
           and Log Mode = Print and Log, then run these and read the log. -->
      <!-- Capability discovery: dumps the raw read-command payloads so the surround/EQ
           key names and the input "mode" codes can be pinned down from a real session. -->
      <!-- Emitter tests: fire ONE code with nothing else in the path. No proxy, no
           capabilities, no Control Method check and no IP address. IR is
           one-way, so "wrong code" and "dead emitter" look identical from the driver; these
           separate them. Output goes through the unsilenceable log path, so they still report
           with Log Mode = Off. -->
      <!-- Power -->
      <!-- Volume / mute -->
      <!-- Inputs -->
      <!-- Sound programs -->
      <!-- DSP / bass -->
      <!-- Forces an immediate volume/mute read instead of waiting for the poll. -->
      <action><name>Refresh Now</name><command>RefreshNow</command></action>
      <!-- Reads everything available right now and prints what the driver ended up knowing,
           so nobody has to shorten "State Poll Seconds" just to see current values. That
           interval is slow by default because every httpapi read is a full mutual-TLS
           handshake, so temporarily speeding it up is exactly the wrong fix. -->
      <action><name>Get Device Status</name><command>GetDeviceStatus</command></action>
      <!-- IR install check. Fires ONE code with nothing else in the path (no proxy, no
           Control Method, no IP address) and reports what Director says is bound to
           the IR output. IR is one-way, so without this a wrong code and a dead emitter or
           unbound port are indistinguishable. Keep it: diagnosing that took three sessions and
           a dead controller port to unpick. -->
      <action><name>Test IR Emitter (fires Power On)</name><command>TestIrEmitter</command></action>
      <!-- IP install check: exercises the whole mutual-TLS path (cert, handshake, request,
           parse) in one press, and is the fastest way to tell a cert problem from a network one. -->
      <action><name>Test IP Control Compatibility</name><command>TestHttpApi</command></action>
    </actions>
