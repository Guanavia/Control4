<devicedata>
  <copyright>Copyright 2026 David Woychek / Property Renewal LLC. All rights reserved.</copyright>
  <creator>David Woychek</creator>
  <manufacturer>Yamaha</manufacturer>
  <name>Yamaha YAS-209 Sound Bar (YXC)</name>
  <model>YAS-209</model>
  <created>2026-07-25</created>
  <modified>2026-07-25</modified>
  <version>1</version>
  <small image_source="c4z">www/icons/device_sm.gif</small>
  <large image_source="c4z">www/icons/device_lg.gif</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <combo>false</combo>

  <proxies qty="1">
    <proxy proxybindingid="5001" name="Yamaha YAS-209" image_source="c4z"
           small_image="www/icons/device_sm.gif" large_image="www/icons/device_lg.gif">receiver</proxy>
  </proxies>

  <capabilities>
    <has_discrete_volume_control>True</has_discrete_volume_control>
    <has_up_down_volume_control>True</has_up_down_volume_control>
    <has_discrete_mute_control>True</has_discrete_mute_control>
    <has_toggle_mute_control>True</has_toggle_mute_control>
    <has_discrete_input_select>True</has_discrete_input_select>
    <allow_audio_pathing>True</allow_audio_pathing>
    <volume_number_of_steps>100</volume_number_of_steps>
  </capabilities>

  <connections>
    <!-- Proxy self connection -->
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Yamaha YAS-209</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>RECEIVER</classname>
        </class>
      </classes>
    </connection>

    <!-- IP control + online monitoring (dealer assigns address in Network tab) -->
    <connection>
      <id>6001</id>
      <type>4</type>
      <facing>6</facing>
      <connectionname>Network Connection</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>NETWORK</classname>
          <ports>
            <port>
              <number>80</number>
              <auto_connect>True</auto_connect>
              <monitor_connection>True</monitor_connection>
              <keep_connection>False</keep_connection>
            </port>
          </ports>
        </class>
      </classes>
    </connection>

    <!-- Room audio/video end-point (this is what binds to the room) -->
    <connection proxybindingid="5001">
      <id>7000</id>
      <type>7</type>
      <connectionname>AUDIO/VIDEO OUTPUT (to Room)</connectionname>
      <consumer>False</consumer>
      <audiosource>True</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>VIDEO_SELECTION</classname>
        </class>
        <class>
          <classname>AUDIO_SELECTION</classname>
        </class>
        <class>
          <classname>AUDIO_VOLUME</classname>
        </class>
      </classes>
    </connection>

    <!-- HDMI Out (passthrough / ARC) to the TV -->
    <connection proxybindingid="5001">
      <id>2000</id>
      <type>5</type>
      <connectionname>HDMI OUT (to TV / ARC)</connectionname>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>HDMI</classname>
        </class>
      </classes>
    </connection>

    <!-- Input sources. <id> is the InputBindingID carried by SET_INPUT.
         Lua INPUT_MAP maps each id -> the device's YXC input id. -->
    <connection proxybindingid="5001">
      <id>3000</id>
      <type>6</type>
      <connectionname>TV Audio (ARC / Optical)</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>DIGITAL_OPTICAL</classname>
        </class>
        <class>
          <classname>STEREO</classname>
        </class>
      </classes>
    </connection>
    <connection proxybindingid="5001">
      <id>3001</id>
      <type>6</type>
      <connectionname>HDMI In</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>True</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>HDMI</classname>
        </class>
      </classes>
    </connection>
    <connection proxybindingid="5001">
      <id>3002</id>
      <type>6</type>
      <connectionname>Optical In</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>DIGITAL_OPTICAL</classname>
        </class>
      </classes>
    </connection>
    <connection proxybindingid="5001">
      <id>3003</id>
      <type>6</type>
      <connectionname>Bluetooth</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>STEREO</classname>
        </class>
      </classes>
    </connection>
    <connection proxybindingid="5001">
      <id>3004</id>
      <type>6</type>
      <connectionname>Network / Streaming</connectionname>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>True</linelevel>
      <classes>
        <class>
          <classname>STEREO</classname>
        </class>
      </classes>
    </connection>
  </connections>

  <config>
    <power_management_method>DiscreteCodes</power_management_method>
    <power_command_delay>0</power_command_delay>
    <power_delay>0</power_delay>
    <power_command_needed>False</power_command_needed>
    <documentation file="www/documentation.rtf" />
    <script file="driver.lua" jit="1" />

    <properties>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>1.0.0</default>
      </property>
      <property>
        <name>IP Address</name>
        <type>STRING</type>
        <readonly>false</readonly>
        <default></default>
        <tooltip>Optional. Overrides the address from the Network connection. Use a DHCP reservation on the soundbar. Leave blank to use the Network connection binding.</tooltip>
      </property>
      <property>
        <name>Connected</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>false</default>
      </property>
      <property>
        <name>Poll Interval Seconds</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>3</default>
        <minimum>1</minimum>
        <maximum>60</maximum>
      </property>
      <property>
        <name>Use Push Events</name>
        <type>LIST</type>
        <readonly>false</readonly>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <tooltip>EXPERIMENTAL. Subscribes to the soundbar's UDP status pushes for lower latency. Polling covers all state without this; validate on hardware before relying on it.</tooltip>
      </property>
      <property>
        <name>Event Listen Port</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>41100</default>
        <minimum>1024</minimum>
        <maximum>65535</maximum>
        <tooltip>UDP port advertised to the soundbar for push events (only used when Use Push Events = On).</tooltip>
      </property>
      <property>
        <name>Volume Ramp Step</name>
        <type>RANGED_INTEGER</type>
        <readonly>false</readonly>
        <default>2</default>
        <minimum>1</minimum>
        <maximum>10</maximum>
        <tooltip>YXC volume step used for volume up/down (ramp/pulse).</tooltip>
      </property>
      <property>
        <name>Sound Program</name>
        <type>LIST</type>
        <readonly>false</readonly>
        <default>(no change)</default>
        <items>
          <item>(no change)</item>
          <item>movie</item>
          <item>music</item>
          <item>tv</item>
          <item>sports</item>
          <item>game</item>
          <item>stereo</item>
        </items>
        <tooltip>Selecting a value sends setSoundProgram. Exact IDs come from getFeatures (see Actions - Query Features).</tooltip>
      </property>
      <property>
        <name>Power State</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Current Input</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Current Volume</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Muted</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default>unknown</default>
      </property>
      <property>
        <name>Now Playing</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default></default>
      </property>
      <property>
        <name>Model</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default></default>
      </property>
      <property>
        <name>Firmware Version</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default></default>
      </property>
      <property>
        <name>Device ID</name>
        <type>STRING</type>
        <readonly>true</readonly>
        <default></default>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <readonly>false</readonly>
        <default>2 - Warning</default>
        <items>
          <item>0 - Alert</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Trace</item>
          <item>5 - Debug</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <readonly>false</readonly>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
    </properties>

    <actions>
      <action>
        <name>Refresh Now</name>
        <command>RefreshNow</command>
      </action>
      <action>
        <name>Query Device Info</name>
        <command>QueryDeviceInfo</command>
      </action>
      <action>
        <name>Query Features (logs inputs and sound programs)</name>
        <command>QueryFeatures</command>
      </action>
      <action>
        <name>Bass Extension On</name>
        <command>BassExtensionOn</command>
      </action>
      <action>
        <name>Bass Extension Off</name>
        <command>BassExtensionOff</command>
      </action>
      <action>
        <name>Clear Voice On</name>
        <command>ClearVoiceOn</command>
      </action>
      <action>
        <name>Clear Voice Off</name>
        <command>ClearVoiceOff</command>
      </action>
      <action>
        <name>3D Surround On</name>
        <command>Surround3DOn</command>
      </action>
      <action>
        <name>3D Surround Off</name>
        <command>Surround3DOff</command>
      </action>
      <action>
        <name>Play</name>
        <command>TransportPlay</command>
      </action>
      <action>
        <name>Pause</name>
        <command>TransportPause</command>
      </action>
      <action>
        <name>Stop</name>
        <command>TransportStop</command>
      </action>
      <action>
        <name>Next Track</name>
        <command>TransportNext</command>
      </action>
      <action>
        <name>Previous Track</name>
        <command>TransportPrevious</command>
      </action>
    </actions>

    <commands>
      <command>
        <name>Set Sleep Timer</name>
        <command>SetSleep</command>
        <params>
          <param>
            <name>Minutes</name>
            <type>LIST</type>
            <items>
              <item>0</item>
              <item>30</item>
              <item>60</item>
              <item>90</item>
              <item>120</item>
            </items>
          </param>
        </params>
      </command>
      <command>
        <name>Set Subwoofer Volume</name>
        <command>SetSubwooferVolume</command>
        <params>
          <param>
            <name>Level</name>
            <type>RANGED_INTEGER</type>
            <minimum>-12</minimum>
            <maximum>12</maximum>
          </param>
        </params>
      </command>
    </commands>
  </config>

  <composer_categories>
    <category>Audio/Video</category>
    <category>Receiver</category>
  </composer_categories>

  <search_types>
    <type>yamaha:soundbar</type>
    <type>yamaha:yas-209</type>
  </search_types>
</devicedata>
